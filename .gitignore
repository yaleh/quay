node_modules/
**/node_modules
dist/
# M120 (DIR-060): the plugin's vendored Core copy IS a committed dist bundle
# (plugin/vendor/quay/dist/quay.js) — negate the bare `dist/` pattern above for
# this one path so `git add` tracks it. Directory first, then its contents.
!plugin/vendor/quay/dist/
!plugin/vendor/quay/dist/**
*.log
.DS_Store
experiment/timing/*.log
.manda/hub.addr
.playwright-mcp/
# QX-033: npm pack build artifacts — do not commit .tgz release files
*.tgz

# BAIME experiment throwaway checkouts / build output — never track
**/worktrees/
**/dist-sea/
**/.quay/gate-events.jsonl

# archguard MCP tool's own local cache/metrics — not source, regenerated per-session
.archguard/

# DIR-031 tree-hygiene: known scratch/backup/tool-output patterns the outer loop's own steps
# (e.g. the L_S mutation proxy) can leave untracked in the main tree — never leave these un-ignored.
*.l-s-backup
*.bak
*.tmp
*.orig
*.swp
*.swo
*.rej
.mutation-backup/
