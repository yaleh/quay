{
  "$schema": "delivery-manifest-v1",
  "description": "Single source of truth for quay release artifacts. release.yml must produce exactly this set — no more, no less.",
  "version": "0.3.12",
  "artifacts": {
    "npm-tarballs": [
      { "package": "quay", "path": "packages/quay", "artifactPattern": "quay-{version}.tgz" }
    ],
    "sea-binaries": [
      { "package": "quay", "platforms": ["linux-x64", "macos-arm64", "windows-x64"] },
      { "package": "quay-native", "platforms": ["linux-x64", "macos-arm64", "windows-x64"] }
    ],
    "plugin": {
      "id": "quay",
      "bundle-type": "marketplace"
    }
  }
}
