package "quay-native 任务 store (store.ts 变门面 + store/*.ts)" {
  component "store.ts 门面\ncreateStore(tasksDir, opts)\n只做装配, 约 40 行, 12 个成员不变" as FAC
  component "task-codec.ts (纯)\nparse / serialize / validateWrittenYaml" as CODEC
  component "task-paths.ts (纯)\nassertSafeId / filePathFor / lockPathFor" as PATHS
  component "task-lock.ts (无状态)\nwithLock / withLocks" as LOCK
  interface "ParseCache" as IPC
  component "parse-cache.ts (有状态 #1)\ncreateParseCache(tasksDir)\nget/set/invalidate/ensureLoaded/flush" as PC
  component "task-view.ts (纯)\ntoViewModel / matchesListFilter" as VIEW
  component "task-reader.ts\ncreateTaskReader(dir, cache)\nget / getMeta / listIds / readRaw" as RD
  component "task-query.ts\nlist / listWithMalformed / queryPage" as Q
  component "task-relations.ts\nfindCurrentParents / add,removeChildRef" as REL
  component "task-change-class.ts (纯)\nclassifyTaskWriteChange" as CC
  component "task-committer.ts (有状态 #2)\ncreateTaskCommitter(tasksDir)\n记忆 gitRoot; 分支感知传播" as TC
  component "task-writer.ts\nwrite / deleteTask / appendNote\n(锁 + CAS + 回滚 + AC-190 + 关系同步)" as WR
}

package "quay-native MCP 层 (不变)" {
  component "mcp-server.ts\n15 个 tool + manifest" as MCP
}

package "goal-store (goal-store.ts 变门面 + goal/*.ts)" {
  component "createGoalStore 门面\n(goalDir,cap,staleMs,judge)→14 成员不变" as GF
  component "goal-read.ts\ntoViewModel/get/list + annotate" as GR
  component "goal-checks.ts (纯读)\nactiveGoals.. checkStaleness,\ncheckReverifyScope, checkStalePass" as GC
  component "criterion-runner.ts\nwithReentrancyGuard(run)\n(目前 2 处手写 env 设置/还原)" as CR
  component "goal-sweep.ts\nsweepFrozen / checkAchievedFailing" as GSW
  component "goal-write.ts\nvalidateGoalWrite → activationGates\n→ assemble/persist/commit" as GW
  component "goal-criterion-lint.ts / goal-ledger.ts /\ngoal-staleness-carrier.ts / goal-cli.ts\n(模块级函数, 纯搬文件)" as GFILES
}

package "quay-github" {
