package "Core 共享层 (packages/quay/src, 新增/扩展)" {
  component "frontmatter-store-base.ts\n(已有, 扩展)" as BASE
  component "frontmatter-record-store.ts\n(新) createRecordStore(spec)\nid/status 守卫, get, list, write 骨架,\nOWNED_KEYS 排序, action 推导, commit 包装" as REC
  component "kernel/task-gate.ts\n(新, 纯函数)\ncheckTaskGate / artifactSections /\nchildrenStatus(getChild 注入)" as TG
  component "store-commit.ts (已有)" as SC
