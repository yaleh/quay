{
  "name": "quay",
  "version": "0.7.1",
  "private": true,
  "description": "Quay Core: provider-agnostic web + CLI + MCP client over the Provider ABI (v0 walking skeleton).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "postinstall": "node scripts/register-plugin.mjs"
  },
  "bin": {
    "quay": "./dist/quay.js"
  },
  "exports": {
    "./adr-store": "./src/adr-store.ts",
    "./document-store": "./src/document-store.ts",
    "./contract-validator": "./src/contract-validator.ts",
    "./init": "./src/init.ts"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "bin",
    "!bin/quay.js",
    "!bin/quay.ts",
    "!bin/node-version-check.cjs",
    "src",
    "dist",
    "plugin",
    "scripts/register-plugin.mjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "d3": "^7.9.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
